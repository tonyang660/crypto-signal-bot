# Bitget API credentials
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Discord
DISCORD_WEBHOOK_URL=
ACTIVE_POSITIONS_WEBHOOK_URL=

# Account and risk
INITIAL_CAPITAL=2000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.06
MAX_LEVERAGE=15.0

# Trading universe
TRADING_PAIRS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,SOLUSDT

# Timeframes
PRIMARY_TIMEFRAME=15m
HTF_TIMEFRAME=4h
ENTRY_TIMEFRAME=5m

# Execution assumptions
MAKER_FEE_PERCENT=0.02
TAKER_FEE_PERCENT=0.06
MIN_SPREAD_PERCENT=0.02
ENTRY_ORDER_TYPE=maker
TAKE_PROFIT_ORDER_TYPE=maker
STOP_LOSS_ORDER_TYPE=taker

# Scheduler
SCAN_INTERVAL_SECONDS=300

# Runtime
TIMEZONE=America/New_York
ENVIRONMENT=development
LOG_LEVEL=INFO
